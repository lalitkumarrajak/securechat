{
  "name": "sanga",
  "version": "2.0.0",
  "description": "Sanga: end-to-end encrypted chat, stories, calls, diary and games, as one app made of separate apps",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js & npm run dev -w @sanga/shell",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node --test --test-concurrency=1 'test/*.test.js'",
    "test:unit": "turbo run test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "cert": "sh scripts/gen-cert.sh"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "mongodb": "^6.21.0",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@module-federation/runtime": "^2.9.2",
    "@module-federation/vite": "^1.23.6",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "heic-to": "^1.6.6",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0"
}
